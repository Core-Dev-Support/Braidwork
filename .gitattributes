# Нормализация переводов строк. Репозиторий общий для Windows, Linux и сборок CI,
# поэтому LF в индексе и CRLF в рабочей копии на Windows — меньше конфликтов.

* text=auto

*.rs      text eol=lf
*.toml    text eol=lf
*.proto   text eol=lf
*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.cs      text eol=lf
*.ts      text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.h       text eol=lf
*.c       text eol=lf
*.cpp     text eol=lf
*.hpp     text eol=lf
*.sh      text eol=lf

# Бинарное: не трогаем
*.png     binary
*.jpg     binary
*.ico     binary
*.apk     binary
*.exe     binary
*.so      binary
*.dll     binary
*.a       binary
*.jar     binary