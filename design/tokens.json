{
  "$schema": "./tokens.schema.json",
  "version": "2.0.0",
  "name": "Braidwork",
  "source": "design/FamSync-design/SPEC.txt, палитра и размеры взяты из спецификации дизайна",

  "color": {
    "light": {
      "base": {
        "appTop": "#E3EAF4",
        "appBottom": "#F1F2F6",
        "app": "#F1F2F6",
        "surface": "#FFFFFF",
        "surfaceSunken": "#F7F8FA",
        "divider": "#F0F0F3"
      },
      "ink": {
        "primary": "#121316",
        "secondary": "#666A75",
        "tertiary": "#9A9CA6",
        "disabled": "#BFC1C9",
        "onAccent": "#FFFFFF"
      },
      "accent": {
        "default": "#1A6FDB",
        "active": "#2B8CF5",
        "subtle": "#E4F1FF"
      },
      "danger": "#C42B2B",
      "status": {
        "online": "#16804A",
        "onlineSubtle": "#E8F6EE",
        "warning": "#C65D0E",
        "warningSubtle": "#FFF1E6",
        "info": "#1A6FDB",
        "infoSubtle": "#E4F1FF",
        "purple": "#6038C9",
        "purpleSubtle": "#EFEAFB",
        "orange": "#FF6A1F",
        "green": "#9BEA3C",
        "cyan": "#4FE3F2"
      }
    },

    "dark": {
      "base": {
        "appTop": "#3B4252",
        "appBottom": "#1B1716",
        "app": "#1B1716",
        "appDeep": "#000000",
        "surface": "#252A33",
        "surfaceHigh": "#313743",
        "divider": "#3A4049"
      },
      "ink": {
        "primary": "#EDEFF5",
        "secondary": "#A8AEBC",
        "tertiary": "#767D8C",
        "disabled": "#4E5561",
        "onAccent": "#FFFFFF"
      },
      "accent": {
        "default": "#5B9BF5",
        "active": "#7FB4F7",
        "subtle": "#1B2C45"
      },
      "danger": "#F0625E",
      "status": {
        "online": "#3DD68C",
        "onlineSubtle": "#13291F",
        "warning": "#E3A43A",
        "warningSubtle": "#2E2415",
        "info": "#5B9BF5",
        "infoSubtle": "#1B2C45",
        "purple": "#B39AF0",
        "purpleSubtle": "#241E3A",
        "orange": "#FF8B4D",
        "green": "#9BEA3C",
        "cyan": "#4FE3F2"
      }
    }
  },

  "gradient": {
    "appLight": { "from": "#E3EAF4", "to": "#F1F2F6", "stopAt": 360 },
    "appDark": { "from": "#3B4252", "to": "#1B1716" },
    "appDeepDark": { "value": "#000000" }
  },

  "typography": {
    "family": "Onest, при отсутствии системный",
    "screenTitle": { "size": 32, "lineHeight": 38, "weight": 700, "letterSpacing": -0.5 },
    "cardTitle": { "size": 20, "lineHeight": 26, "weight": 600 },
    "modeLabel": { "size": 15, "lineHeight": 20, "weight": 500 },
    "rowTitle": { "size": 16, "lineHeight": 22, "weight": 500 },
    "body": { "size": 14, "lineHeight": 20, "weight": 400 },
    "caption": { "size": 13, "lineHeight": 18, "weight": 400 },
    "label": { "size": 11, "lineHeight": 15, "weight": 600 }
  },

  "radius": {
    "iconChip": 12,
    "iconTileLarge": 18,
    "button": 28,
    "card": 24,
    "cardScreen": 28,
    "pill": 999
  },

  "spacing": {
    "screenH": 24,
    "cardH": 16,
    "cardV": 20,
    "gapTight": 8,
    "gap": 12,
    "gapWide": 16,
    "gapSection": 18,
    "topInset": 60
  },

  "size": {
    "touchMin": 48,
    "cardMinHeight": 56,
    "listRowMin": 56,
    "listRowWithCaption": 66,
    "listRowWithIcon": 64,
    "iconChip": 40,
    "iconTileLarge": 64,
    "iconTileGlyph": 34,
    "buttonHeight": 56,
    "modeButton": 68,
    "switchWidth": 52,
    "switchHeight": 32,
    "switchThumb": 28,
    "navBarHeight": 84,
    "navIcon": 26,
    "navTouch": 44,
    "headerButton": 44,
    "headerIcon": 26
  },

  "elevation": {
    "card": "0 1px 2px rgba(20,30,50,0.04)",
    "floating": "0 8px 24px rgba(20,30,50,0.10)"
  },

  "component": {
    "navBar": {
      "height": 84,
      "iconSize": 26,
      "labelSize": 11,
      "items": ["home", "devices", "share", "family", "settings"]
    },
    "modeButtons": {
      "count": 3,
      "size": 68,
      "labels": ["Только LAN", "Авто", "Интернет"]
    }
  },

  "icon": {
    "grid": 24,
    "stroke": 1.8,
    "strokeRound": true,
    "fill": "none",
    "note": "Иконки заданы путями SVG и переносятся в VectorDrawable без изменения обводки"
  },

  "note": "Палитра и размеры перенесены из спецификации дизайна. Минимальная область нажатия 48, а не 44: на Android 44 уменьшает доступность, и это единственное расхождение со спецификацией."
}