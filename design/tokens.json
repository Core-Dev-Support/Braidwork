{
  "$schema": "./tokens.schema.json",
  "version": "1.0.0",
  "name": "Braidwork",

  "color": {
    "light": {
      "base": {
        "app": "#F4F5F8",
        "surface": "#FFFFFF",
        "surfaceSunken": "#EDEFF3",
        "surfaceInset": "#E4E7EE",
        "overlay": "#FFFFFF",
        "divider": "#DFE3EB"
      },
      "ink": {
        "primary": "#12151C",
        "secondary": "#565E70",
        "tertiary": "#858DA0",
        "disabled": "#A8AEBF",
        "onDark": "#FFFFFF",
        "onAccent": "#FFFFFF"
      },
      "accent": {
        "default": "#3B6FF6",
        "pressed": "#2F5CD8",
        "subtle": "#E4EBFD"
      },
      "dark": {
        "app": "#171A22",
        "surface": "#22262F",
        "surfaceHigh": "#2C313C",
        "ink": "#FFFFFF",
        "inkMuted": "#B4BAC7"
      },
      "state": {
        "online": "#1F9D55",
        "onlineSubtle": "#E2F4EA",
        "warning": "#C77700",
        "warningSubtle": "#FCF0DC",
        "danger": "#D03B3B",
        "dangerSubtle": "#FCE8E8",
        "idle": "#858DA0",
        "idleSubtle": "#EDEFF3",
        "info": "#3B6FF6",
        "infoSubtle": "#E4EBFD"
      }
    },

    "dark": {
      "base": {
        "app": "#12141A",
        "surface": "#1B1E26",
        "surfaceSunken": "#0E1015",
        "surfaceInset": "#232733",
        "overlay": "#242833",
        "divider": "#2E3340"
      },
      "ink": {
        "primary": "#EDEFF5",
        "secondary": "#A6ADBD",
        "tertiary": "#727A8B",
        "disabled": "#4B5261",
        "onDark": "#12141A",
        "onAccent": "#FFFFFF"
      },
      "accent": {
        "default": "#5B87F8",
        "pressed": "#7A9DFF",
        "subtle": "#1E2A47"
      },
      "dark": {
        "app": "#3C4250",
        "surface": "#2A2F3B",
        "surfaceHigh": "#343A48",
        "ink": "#EDEFF5",
        "inkMuted": "#A6ADBD"
      },
      "state": {
        "online": "#3DD68C",
        "onlineSubtle": "#13291F",
        "warning": "#E3A43A",
        "warningSubtle": "#2E2415",
        "danger": "#F0625E",
        "dangerSubtle": "#2F1919",
        "idle": "#727A8B",
        "idleSubtle": "#21252E",
        "info": "#5B87F8",
        "infoSubtle": "#1A2440"
      }
    }
  },

  "spacing": {
    "space2": 2,
    "space4": 4,
    "space8": 8,
    "space12": 12,
    "space16": 16,
    "space20": 20,
    "space24": 24,
    "space32": 32,
    "space40": 40,
    "space48": 48
  },

  "radius": {
    "chip": 12,
    "control": 14,
    "card": 20,
    "cardLarge": 26,
    "screen": 28,
    "pill": 999
  },

  "typography": {
    "scale": {
      "displaySmall": { "size": 30, "lineHeight": 38, "weight": 700 },
      "headlineLarge": { "size": 24, "lineHeight": 32, "weight": 700 },
      "headlineMedium": { "size": 20, "lineHeight": 28, "weight": 600 },
      "titleLarge": { "size": 18, "lineHeight": 26, "weight": 600 },
      "titleMedium": { "size": 16, "lineHeight": 24, "weight": 600 },
      "bodyLarge": { "size": 16, "lineHeight": 24, "weight": 400 },
      "bodyMedium": { "size": 14, "lineHeight": 21, "weight": 400 },
      "bodySmall": { "size": 13, "lineHeight": 19, "weight": 400 },
      "labelLarge": { "size": 14, "lineHeight": 20, "weight": 600 },
      "labelMedium": { "size": 12, "lineHeight": 17, "weight": 600 },
      "labelSmall": { "size": 11, "lineHeight": 15, "weight": 500 }
    },
    "families": {
      "ui": "системный шрифт платформы",
      "mono": "моноширинный шрифт для отпечатков и идентификаторов"
    }
  },

  "elevation": {
    "flat": { "light": "0 0 0 0 #00000000", "dark": "0 0 0 0 #00000000" },
    "raised": { "light": "0 1px 2px #0F172A14", "dark": "0 1px 2px #00000033" },
    "card": { "light": "0 2px 8px #0F172A0F", "dark": "0 2px 8px #00000040" },
    "floating": { "light": "0 8px 24px #0F172A1F", "dark": "0 8px 24px #00000059" },
    "sheet": { "light": "0 -8px 32px #0F172A24", "dark": "0 -8px 32px #00000066" }
  },

  "motion": {
    "durationFast": 120,
    "durationNormal": 220,
    "durationSlow": 360,
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easingDecelerate": "cubic-bezier(0, 0, 0, 1)"
  },

  "size": {
    "touchTargetMin": 48,
    "iconSmall": 16,
    "iconDefault": 20,
    "iconLarge": 24,
    "iconFeature": 40,
    "batteryWidth": 28,
    "batteryHeight": 12,
    "navBarHeight": 64,
    "topBarHeight": 56,
    "hairline": 1
  },

  "component": {
    "card": {
      "padding": "space16",
      "gap": "space12",
      "radius": "radius.card",
      "background": "base.surface",
      "border": "base.divider",
      "borderWidth": "size.hairline"
    },
    "chip": {
      "paddingHorizontal": "space12",
      "paddingVertical": "space8",
      "radius": "radius.chip",
      "font": "typography.labelMedium"
    },
    "featureChip": {
      "paddingHorizontal": "space16",
      "paddingVertical": "space12",
      "radius": "radius.control",
      "font": "typography.bodyMedium"
    },
    "switch": {
      "width": 52,
      "height": 32,
      "thumbSize": 26
    },
    "listRow": {
      "minHeight": 64,
      "paddingVertical": "space12",
      "paddingHorizontal": "space16",
      "gap": "space12"
    },
    "topBar": {
      "height": "size.topBarHeight",
      "paddingHorizontal": "space20"
    },
    "navBar": {
      "height": "size.navBarHeight",
      "labelFont": "typography.labelSmall",
      "iconSize": "size.iconDefault"
    }
  },

  "note": "Порядок и имена токенов едины для всех платформ. Каждая платформа генерирует из этого файла свою тему; вручную цвета не подбираются нигде."
}